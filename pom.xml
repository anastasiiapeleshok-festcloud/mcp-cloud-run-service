<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.festcloud.adkpoc</groupId>
  <artifactId>adk-mcp-sandbox-service</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <!--
    Sibling of adk-mcp-sandbox: same "agents scope" (orchestrator_agent + operaton_agent,
    real Runner, real LoggingPlugin, real McpSessionManager) — engine/agent and
    engine/api are byte-for-byte copies. The ONLY thing that changes is HOW the sandbox
    is provisioned and talked to: Cloud Run SERVICE (concurrency=1 + session affinity,
    direct inbound HTTP) instead of Cloud Run JOB (runJobAsync + outbound WebSocket
    broker). See engine/sandbox/SandboxSessionManager.java and sandbox-service/ for the
    actual delta.
  -->

  <modules>
    <module>engine</module>
    <module>sandbox-service</module>
  </modules>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <google-adk.version>1.9.0</google-adk.version>
    <google-auth.version>1.30.1</google-auth.version>
    <jackson.version>2.17.2</jackson.version>
    <slf4j.version>2.0.13</slf4j.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Same Artifact Registry cloud-adk itself resolves com.google.adk from. -->
  <repositories>
    <repository>
      <id>festcloud.releases</id>
      <url>artifactregistry://europe-west4-maven.pkg.dev/gcp-shared-srv-w8y7/gcp-shared-srv-w8y7-ar-maven-releases</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>
